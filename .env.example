# Copy this file to .env and fill in whichever keys you have.
# yfinance needs no key and is always used as the baseline source.

# Free tier at https://www.alphavantage.co/support/#api-key (25 requests/day)
ALPHAVANTAGE_API_KEY=

# Free tier (delayed EOD data) or paid (real-time), from https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=

# Trading days ahead the models predict (default 1 = next session)
PREDICTION_HORIZON_DAYS=1

# Years of history to pull when training from scratch
DEFAULT_LOOKBACK_YEARS=5
